{
    "name": "franciscoh/mcp-trello",
    "description": "Servidor MCP (stdio) para Trello en PHP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "mcp/sdk": "^0.10",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": { "McpTrello\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "McpTrello\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
